<config xmlns="http://www.ehcache.org/v3">

  <!-- Room for two languages only -->
  <cache alias="com.howtodoinjava.hibernate.ehcacheconfig.Language">
    <heap unit="entries">2</heap>
  </cache>

  <!-- Two languages on the heap, the rest off the heap -->
  <cache alias="translations">
    <resources>
      <heap unit="entries">2</heap>
      <offheap unit="MB">10</offheap>
    </resources>
  </cache>

  <cache alias="com.howtodoinjava.hibernate.ehcacheconfig.Language.translations">
    <heap unit="entries">100</heap>
  </cache>
  <cache alias="default-query-results-region">
    <heap unit="entries">100</heap>
  </cache>
  <cache alias="default-update-timestamps-region">
    <expiry>
      <none/>
    </expiry>
    <heap unit="entries">100</heap>
  </cache>
</config>
