<config xmlns="http://www.ehcache.org/v3">

  <cache-template name="labels">
    <heap unit="entries">100</heap>
  </cache-template>

  <cache alias="com.howtodoinjava.hibernate.ehcacheconfig.ReadOnlyLabel" uses-template="labels"/>
  <cache alias="com.howtodoinjava.hibernate.ehcacheconfig.NonstrictLabel" uses-template="labels"/>
  <cache alias="com.howtodoinjava.hibernate.ehcacheconfig.ReadWriteLabel" uses-template="labels"/>
  <cache alias="com.howtodoinjava.hibernate.ehcacheconfig.TransactionalLabel" uses-template="labels"/>

  <cache alias="com.howtodoinjava.hibernate.ehcacheconfig.Language" uses-template="labels"/>
  <cache alias="com.howtodoinjava.hibernate.ehcacheconfig.Language.translations" uses-template="labels"/>
  <cache alias="translations" uses-template="labels"/>
  <cache alias="default-query-results-region" uses-template="labels"/>
  <cache alias="default-update-timestamps-region">
    <expiry>
      <none/>
    </expiry>
    <heap unit="entries">100</heap>
  </cache>
</config>
